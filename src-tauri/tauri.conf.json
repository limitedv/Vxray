{
  "productName": "Vxray",
  "version": "2.0.1",
  "identifier": "com.vxray.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vxray",
        "width": 1050,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../bin/sing-box.exe",
      "../bin/xray.exe",
      "../bin/geoip.dat",
      "../bin/geosite.dat",
      "../bin/stat-tracker.exe",
      "../bin/vxray-tun.exe",
      "../bin/wintun.dll"
    ],
    "publisher": "Vxray",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "template": "installer.nsi"
      }
    }
  }
}
