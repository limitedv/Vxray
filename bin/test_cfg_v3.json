{
  "dns": {
    "final": "dns_remote",
    "rules": [
      {
        "outbound": "any",
        "server": "dns_remote"
      }
    ],
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "detour": "proxy",
        "tag": "dns_remote"
      },
      {
        "address": "local",
        "detour": "direct",
        "tag": "dns_local"
      }
    ],
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "listen_port": 2085,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "packet_encoding": "xudp",
      "server": "192.206.179.241",
      "server_port": 2053,
      "tag": "proxy",
      "tls": {
        "enabled": true,
        "insecure": true,
        "server_name": "liz2.pishi.lat",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "transport": {
        "headers": {
          "Host": "liz2.pishi.lat"
        },
        "path": "/lizard",
        "type": "ws"
      },
      "type": "vless",
      "uuid": "0e61c812-49f0-4dd3-992d-654d47c52a0f"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "dns-out",
      "type": "dns"
    }
  ],
  "route": {
    "auto_detect_interface": false,
    "final": "proxy",
    "rules": [
      {
        "outbound": "dns-out",
        "protocol": "dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ]
  }
}